# Skopiuj do desktop/.env (plik ignorowany przez git) i uzupełnij.
# Token wysyłki paczek na serwer telefonu — wypisuje go mobile/api/tools/make-config.php.
BYKU_MOBILE_UPLOAD_TOKEN=
# Opis z podstawy (AI). Wystarczy jeden klucz; przy obu wygrywa Claude, chyba że AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
AI_PROVIDER=
